@model MiniVentas.ViewModels.Usuarios.UsuarioIndexViewModel
@{
    ViewData["Title"] = "Usuarios y Roles";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Usuarios y Roles</h3>
    </div>
    <a asp-action="Crear" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-person-plus"></i>
        <span>Nuevo Usuario</span>
    </a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Aviso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label asp-for="Busqueda" class="form-label small fw-semibold text-muted">Buscar por Usuario, Nombre o Cód. Vendedor</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input asp-for="Busqueda" class="form-control" />
                </div>
            </div>
            <div class="col-md-3">
                <label asp-for="RolId" class="form-label small fw-semibold text-muted">Rol</label>
                <select asp-for="RolId" class="form-select">
                    <option value="">Todos</option>
                    <option value="1">Administrador</option>
                    <option value="2">Vendedor</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="SoloActivos" class="form-label small fw-semibold text-muted">Estado</label>
                <select asp-for="SoloActivos" class="form-select">
                    <option value="">Todos</option>
                    <option value="true">Activos</option>
                    <option value="false">Inactivos</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark flex-grow-1">Filtrar</button>
                @if (!string.IsNullOrEmpty(Model.Busqueda) || Model.RolId.HasValue || Model.SoloActivos.HasValue)
                {
                    <a asp-action="Index" class="btn btn-secondary" title="Limpiar filtros">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Usuario</th>
                    <th>Nombre Completo</th>
                    <th>Rol</th>
                    <th>Cód. Vendedor</th>
                    <th>Zona de Ventas</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Usuarios.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2 d-block mb-2"></i>
                            No se encontraron usuarios con los criterios seleccionados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Usuarios)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@item.NombreUsuario</td>
                            <td>@item.Nombre</td>
                            <td>
                                @if (item.RolCodigo == "ADMIN")
                                {
                                    <span class="badge bg-dark">ADMIN</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">VENDEDOR</span>
                                }
                            </td>
                            <td>@(item.CodigoVendedor ?? "-")</td>
                            <td>@(item.ZonaVentas ?? "-")</td>
                            <td class="text-center">
                                @if (item.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Editar" asp-route-id="@item.UsuarioId"
                                       class="btn btn-sm btn-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @if (item.Activo)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                title="Desactivar"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalCambiarEstado"
                                                data-id="@item.UsuarioId"
                                                data-nombre="@item.NombreUsuario"
                                                data-activo="false">
                                            <i class="bi bi-slash-circle"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-success"
                                                title="Activar"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalCambiarEstado"
                                                data-id="@item.UsuarioId"
                                                data-nombre="@item.NombreUsuario"
                                                data-activo="true">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalCambiarEstado" tabindex="-1" aria-labelledby="modalCambiarEstadoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalCambiarEstadoLabel">Confirmar acción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-0" id="modalMensajeEstado"></p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="CambiarEstado" method="post" class="d-inline">
                    <input type="hidden" name="id" id="inputEstadoId" />
                    <input type="hidden" name="activo" id="inputEstadoActivo" />
                    <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                    <input type="hidden" name="rolId" value="@Model.RolId" />
                    <input type="hidden" name="soloActivos" value="@(Model.SoloActivos?.ToString().ToLowerInvariant())" />
                    <button type="submit" class="btn" id="btnConfirmarEstado">Confirmar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/usuario/index.js" asp-append-version="true"></script>
}