@model MiniVentas.ViewModels.Productos.ProductoFormViewModel
@{
    string titulo = Model.EsEdicion ? "Editar Producto" : "Nuevo Producto";
    string accion = Model.EsEdicion ? "Editar" : "Crear";
    ViewData["Title"] = titulo;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="mb-3">
            <h4 class="fw-bold mb-0">@titulo</h4>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="@accion" asp-route-id="@(Model.EsEdicion ? Model.ProductoId : null)" method="post">
                    <input type="hidden" asp-for="ProductoId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Sku" class="form-label fw-semibold"></label>
                        <input asp-for="Sku" class="form-control text-uppercase" maxlength="32" autofocus />
                        <span asp-validation-for="Sku" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" maxlength="120" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PrecioVenta" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">S/</span>
                            <input asp-for="PrecioVenta" type="number" step="0.01" min="0"
                                   value="@Model.PrecioVenta.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control" />
                        </div>
                        <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="Activo" class="form-check-input" role="switch" />
                            <label asp-for="Activo" class="form-check-label fw-semibold"></label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i>@(Model.EsEdicion ? "Actualizar Producto" : "Guardar Producto")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
