@model MiniVentas.ViewModels.Clientes.ClienteFormViewModel
@{
    string titulo = Model.EsEdicion ? "Editar Cliente" : "Nuevo Cliente";
    string accion = Model.EsEdicion ? "Editar" : "Crear";
    ViewData["Title"] = titulo;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="mb-3">
            <h4 class="fw-bold mb-0">@titulo</h4>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="@accion" asp-route-id="@(Model.EsEdicion ? Model.ClienteId : null)" method="post">
                    <input type="hidden" asp-for="ClienteId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label asp-for="TipoDocumento" class="form-label fw-semibold"></label>
                            <select asp-for="TipoDocumento" class="form-select" id="selectTipoDocumento">
                                <option value="1">DNI (8 dígitos)</option>
                                <option value="6">RUC (11 dígitos)</option>
                                <option value="4">Carnet de Extranjería</option>
                                <option value="7">Pasaporte</option>
                            </select>
                            <span asp-validation-for="TipoDocumento" class="text-danger small"></span>
                        </div>

                        <div class="col-md-7">
                            <label asp-for="NumeroDocumento" class="form-label fw-semibold"></label>
                            <input asp-for="NumeroDocumento" class="form-control text-uppercase"
                                   id="inputNumeroDocumento" maxlength="12" autofocus />
                            <span asp-validation-for="NumeroDocumento" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control text-uppercase" maxlength="160" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i>@(Model.EsEdicion ? "Actualizar Cliente" : "Guardar Cliente")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cliente/formulario.js" asp-append-version="true"></script>
}
